# Supabase — projeto AGK (qqbeoljgpfllhcvqrsup)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# service_role: NUNCA expor no client/browser. Usada só nos scripts server-side e no admin client do app.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Front-end (Next.js) — expostas ao browser (só usadas para o Supabase Auth; RLS deny-all impede leitura de dados)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Bubble — endpoints de leitura para a migração de dados
BUBBLE_API_BASE=https://<app>.bubbleapps.io/api/1.1
BUBBLE_API_TOKEN=<token-se-necessario>

# Resend — envio de e-mail transacional (convites). Server-side apenas: NUNCA
# com prefixo NEXT_PUBLIC_. Chave `re_...` em https://resend.com/api-keys
# (permissão "Sending access" basta). Contorna o SMTP do Supabase.
RESEND_API_KEY=<re_...>
# Remetente. O default `onboarding@resend.dev` (domínio de teste do Resend) só
# entrega para o e-mail dono da conta Resend — use para validar. Em produção,
# aponte para um remetente de domínio verificado, ex.: "SOTWISE <no-reply@seudominio.com>".
EMAIL_FROM=SOTWISE <onboarding@resend.dev>

# Copilot — chave da API da Anthropic (conta AGK). Server-side apenas:
# NUNCA com prefixo NEXT_PUBLIC_. Console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=<sk-ant-...>

# API REST (app/api/**) — token de serviço para consumo maquina-a-maquina.
# Cobre tanto os cadastros (app/api/[resource]) quanto Orders (app/api/orders,
# via inbound do GSS). Opcional: se vazio, a API aceita SO sessao (cookie). Se
# setado, aceita tambem `Authorization: Bearer <API_TOKEN>`.
# Gere um valor forte: `openssl rand -hex 32`. NUNCA com prefixo NEXT_PUBLIC_.
API_TOKEN=<token-forte-opcional>
# Token SO-LEITURA de PO para consumidor externo (nao o GSS): so libera
# GET /api/orders (sem include=checklist); o resto da API responde 403.
# Opcional; revogar = apagar a env. Gere com `openssl rand -hex 32`.
API_TOKEN_PO_READ=<token-forte-opcional>

# GSS / AGK-Core — LEITURA das bibliotecas (ver lib/gss/client.ts e
# docs/INTEGRACAO_GSS.md). Server-side apenas: NUNCA com prefixo NEXT_PUBLIC_.
# Duas camadas: Cloudflare Access (service token) + JWT (usuario tecnico).
GSS_API_BASE=https://api.gssdatahub.com/v1
GSS_CF_ACCESS_CLIENT_ID=<cloudflare-client-id>
GSS_CF_ACCESS_CLIENT_SECRET=<cloudflare-client-secret>
GSS_USERNAME=<usuario-tecnico>
GSS_PASSWORD=<senha>

# CRON de sync do GSS (app/api/cron/sync-gss) — segredo do agendador (Vercel Cron).
# Enviado como `Authorization: Bearer <CRON_SECRET>`. `openssl rand -hex 32`.
CRON_SECRET=<token-forte-do-cron>

# Webhook de recebimento do Resend (app/api/webhooks/resend) — resposta do
# cliente ao "e-mail manual por etapa" do checklist. Diferente de
# CRON_SECRET/API_TOKEN (bearer estático): aqui é o Signing Secret
# que o Resend gera ao criar o Webhook (`whsec_...`), usado pra verificar a
# assinatura Svix do corpo (não um token comparado por igualdade). Exige
# "Receiving" ativado no domínio de EMAIL_FROM (ver docs/regras_de_negocio.md).
RESEND_WEBHOOK_SECRET=<whsec_...>

# WeChat (Service Account, 服务号) — fase 1: mensagens da EQUIPE, ida e volta
# (lib/wechat, app/api/wechat/callback, docs §6.15). Sem APP_ID/APP_SECRET o
# WeChat fica desligado e nada muda. Tudo server-side, nunca NEXT_PUBLIC_.
#   APP_*: 开发 → 基本配置 → AppID / AppSecret (no 测试号: appID / appsecret).
#   TOKEN: 服务器配置 → Token (você inventa; o mesmo valor nos dois lados).
#   AES_KEY: 服务器配置 → EncodingAESKey (43 chars). Com ela, SÓ modo seguro.
#     Deixe vazia no 测试号 (só tem texto claro).
#   TEMPLATE_*: aviso fora da janela de 48h (lib/wechat/template.ts). Sem eles,
#     quem está fora da janela não recebe (fica "failed" no log).
#   RELAY_*: relay de IP fixo (relay/wechat/README.md) — a conta só entrega
#     token a IPs da IP白名单 e a Vercel não tem IP fixo. Vazio = chama direto.
#   LINK_BASE_URL: base do link "Open in SOT" (ex.: https://sot.gssdatahub.com).
#   WECHAT_DISABLED=true desliga sem mexer nas outras.
WECHAT_APP_ID=<wx...>
WECHAT_APP_SECRET=<appsecret>
WECHAT_TOKEN=<token-do-servidor>
WECHAT_AES_KEY=<EncodingAESKey-43-chars>
WECHAT_TEMPLATE_ID=<template-id>
WECHAT_TEMPLATE_FIELDS=<thing1=author,character_string2=record,thing3=body,time4=time>
WECHAT_RELAY_URL=<https://relay...>
WECHAT_RELAY_SECRET=<openssl rand -hex 32>
WECHAT_LINK_BASE_URL=<https://sot.gssdatahub.com>
