            ]
          }
        }
      ]
    },
    {
      "name": "8. PATCH po — leva de Factory × Category conclui a etapa — 200",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
