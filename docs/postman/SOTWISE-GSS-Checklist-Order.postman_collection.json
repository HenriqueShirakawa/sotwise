        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"supplier_category_gss_id\": \"{{sc_id}}\",\n      \"ship_requirement\": {{d_ship}}\n    }\n  ]\n}",
          "options": {
