      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('continua com 2 registros', () => pm.expect(pm.response.json().data.revisions).to.have.length(2));"
            ]
          }
        }
      ]
    },
